# API Configuration
API_URL=http://192.168.100.14:8888

# App Environment
NODE_ENV=development
EXPO_PUBLIC_ENV=development

# API Endpoints
EXPO_PUBLIC_API_URL=http://192.168.100.14:8888
EXPO_PUBLIC_API_AUTH_URL=http://192.168.100.14:8888/api/auth
EXPO_PUBLIC_API_PARTS_URL=http://192.168.100.14:8888/api/parts

# Upload Configuration
EXPO_PUBLIC_MAX_IMAGE_SIZE=5242880
EXPO_PUBLIC_MAX_IMAGES_PER_MESSAGE=2

# Location Settings
EXPO_PUBLIC_DEFAULT_RADIUS=50
EXPO_PUBLIC_MAX_RADIUS=200

# App Settings
EXPO_PUBLIC_APP_NAME=iPiece
EXPO_PUBLIC_APP_VERSION=1.0.0

# Real-time Configuration
EXPO_PUBLIC_RECONNECT_INTERVAL=5000
EXPO_PUBLIC_HEARTBEAT_INTERVAL=30000

# Pagination
EXPO_PUBLIC_DEFAULT_LIMIT=20
EXPO_PUBLIC_MAX_LIMIT=100

# Debug
EXPO_PUBLIC_DEBUG=true
EXPO_PUBLIC_LOG_LEVEL=debug
